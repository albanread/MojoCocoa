# Avoid PATH leaking into actions
common --incompatible_strict_action_env

# Don't fail on unknown GPUs, add needed GPUs to common.MODULE.bazel
common --repo_env=MOJO_IGNORE_UNKNOWN_GPUS=1

# Silence warnings in external dependencies used in tests
build --per_file_copt=external/.*@-w --host_per_file_copt=external/.*@-w

import %workspace%/bazel/internal/common.bazelrc

# Load config generated from tools/bazel
import %workspace%/build/wrapper.bazelrc

build --remote_instance_name=modular-public

build --compilation_mode=dbg
build --//:modular_config=default

build:ci --mojoprecompilecopt=-Werror

build:public-cache --bes_backend=grpcs://modular-public.buildbuddy.io
build:public-cache --bes_results_url=https://modular-public.buildbuddy.io/invocation/
build:public-cache --build_metadata=VISIBILITY=PUBLIC
build:public-cache --remote_downloader=grpcs://modular-public.buildbuddy.io
build:public-cache --remote_cache=grpcs://modular-public.buildbuddy.io

build:build-mojo --//:use_prebuilt_mojo_toolchain=false
build:prebuilt-mojo --//:use_prebuilt_mojo_toolchain=true

# ---------------------------------------------------------------------------
# The release build: what ships in dist/CocoaMojo.
#
#   ./bazelw build --config=build-mojo --config=release //KGEN/tools/mojo:mojo
#
# The default build above is `--compilation_mode=dbg`. That is why the compiler
# is 169 MB with a 49 MB symbol table, and why it is slower than it needs to be
# at the one job it has. Nothing about this fork requires a debug LLVM.
#
# Every flag here changes the action key, so this config gets its own output
# tree (darwin_arm64-opt). That costs one full build and then stays warm -- and
# it means a failure here leaves the working dbg toolchain exactly where it was.
build:release --compilation_mode=opt

# Tune for the machine this actually runs on. There is one, and we know what it
# is: -mcpu=apple-m4 lets LLVM schedule for the M-series pipeline and use the
# ISA extensions instead of a conservative baseline arm64. Applied to host tools
# as well, because those run here too.
build:release --copt=-mcpu=apple-m4
build:release --host_copt=-mcpu=apple-m4
build:release --cxxopt=-mcpu=apple-m4
build:release --host_cxxopt=-mcpu=apple-m4

# Link LLVM as a shared library rather than folding it into every binary.
# bazel/internal/common.bazelrc turns dynamic linking off globally with a note
# about circular dependency linking issues; those bite the full Modular graph,
# which this fork does not build. Re-enabling it here keeps the blast radius
# inside this config: if the link fails, the dbg tree is untouched.
build:release --dynamic_mode=default
build:release --features=supports_dynamic_linker

# Compile LLVM and MLIR with default symbol visibility, so
# //bazel/llvm-shared:LLVM and //bazel/mlir-shared:MLIR are libraries other
# things can actually call.
#
# bazel/internal/cc-toolchain/args/BUILD.bazel:124-125 applies -fvisibility=hidden
# across the whole toolchain. For a single static binary that is free size; for a
# dylib it is fatal and silently so -- LLVM linked with -all_load under hidden
# visibility produced ~13,000 defined text symbols and 192 exported ones, and
# nothing outside could call in. Same setting, same shape of bug, as the AsyncRT
# device symbols that link and then cannot be found at run time.
#
# Scoped to llvm-project/llvm by path, in the style of the nixl_upstream line in
# bazel/internal/common.bazelrc:175. -fno-visibility-inlines-hidden matters too:
# without it LLVM's inline and template members stay hidden, which is exactly the
# set a consumer needs and the hardest to notice missing.
build:release --per_file_copt=external/.*llvm-project/(llvm|mlir)/.*@-fvisibility=default,-fno-visibility-inlines-hidden
build:release --host_per_file_copt=external/.*llvm-project/(llvm|mlir)/.*@-fvisibility=default,-fno-visibility-inlines-hidden

# The compiler's own code, for //KGEN:MojoCompilerShared. Without this the front
# end links into libMojoCompiler.dylib and exports nothing, which is the same
# silent failure as LLVM's: the dylib builds, and no embedder can call in.
build:release --per_file_copt=^(KGEN|Support|Init|Config|Cache|AsyncRT)/.*@-fvisibility=default,-fno-visibility-inlines-hidden
build:release --host_per_file_copt=^(KGEN|Support|Init|Config|Cache|AsyncRT)/.*@-fvisibility=default,-fno-visibility-inlines-hidden

# zlib-ng and zstd are compression backends LLVM's Support links, so they land
# inside libLLVM.dylib and have to be callable from outside it for the same
# reason everything else does.
build:release --per_file_copt=external/.*(zlib-ng|zstd).*@-fvisibility=default
build:release --host_per_file_copt=external/.*(zlib-ng|zstd).*@-fvisibility=default

# Check for a local gitignored bazel config.
# NOTE: Import this last so that local configs can override.
try-import %workspace%/local.bazelrc

# ---------------------------------------------------------------------------
# Fast iteration on the compiler itself.
#
#   ./bazelw build //KGEN/tools/mojo:mojo --config=iter
#
# Drops the mypy aspect, which type-checks Python on every build including
# pure-C++ ones, and trims test chatter. Safe to use while iterating; run a
# plain build before trusting a result you intend to publish.
build:iter --config=disable-lint
build:iter --test_summary=terse
# NOTE: deliberately no test_output setting here -- a config-set
# --test_output=errors silently OVERRIDES an explicit
# --test_output=all on the command line, which swallows the very
# output you asked for. bazel warns, quietly, and you lose a run.

# ---------------------------------------------------------------------------
# NOTES ON WHY BUILDS HURT HERE, so the next person does not rediscover them.
#
# 1. `mojo` is ~170 MB and statically linked, so ANY change to a backend
#    source relinks all of it. That is not an LLVM constraint -- it is
#    `build --dynamic_mode=off` plus `--features=-supports_dynamic_linker` in
#    bazel/internal/common.bazelrc:77-78. A shared libLLVM/libMLIR would cut
#    the relink to the delta. Changing it re-keys the graph once (one full
#    rebuild) and is cheaper every time after; worth measuring before adopting.
#
# 2. `--action_env=FOO=1` enters the key of EVERY action, so it invalidates
#    the whole graph -- one boolean cost 3,610 actions here, LLVM included.
#    local.bazelrc already warns about this. For toggling backend experiments
#    use the file knob instead (no rebuild at all):
#
#      echo 'APPLEGPU_AIR_SCALARIZE_WIDE_VECTORS=1' > /tmp/applegpu-xforms.conf
#
#    See airKnob() in
#    KGEN/lib/Compiler/ObjectCompiler/Target/Air/AirBackend.cpp. The binary
#    carries both code paths; the file decides at run time and is not a bazel
#    input, so nothing rebuilds.
#
# 3. The Mojo KERNEL cache (~/.cache/modular/.mojo_cache) is keyed on the
#    kernel body, not on the compiler binary and not on the environment. A
#    rebuilt compiler will happily serve you yesterday's kernel. Use
#    ./clear_cache.sh, or ./rebuild.sh which does both and verifies the binary
#    actually contains your change.
