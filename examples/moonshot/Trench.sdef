<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!-- The terminology, not the transport. Events reach the handler by their
     raw codes with or without this file; what the sdef adds is the words,
     so Script Editor compiles `do command "status"` rather than
     «event TRNCcmnd». One verb on purpose: the surface is the command
     language, and `do command "help"` lists it. -->
<dictionary title="Trench Terminology">
  <suite name="Trench Suite" code="TRNC"
         description="Drive the Trench flight-planning console. One verb; the
                      argument is the command language - send &quot;help&quot;
                      for the list.">
    <command name="do command" code="TRNCcmnd"
             description="Run one Trench command and return its reply.">
      <direct-parameter type="text"
                        description="the command, e.g. status, replan, fly,
                                     hold, mode map,
                                     screenshot /tmp/trench.png"/>
      <result type="text" description="one line of reply"/>
    </command>
  </suite>
</dictionary>
