load("//bazel:api.bzl", "mojo_filecheck_test", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

_FILECHECK_TESTS = [
    "test_stencil1d.mojo",
    "test_stencil2d.mojo",
]

_EXTRA_CONSTRAINTS = {
    "test_tiled_matmul_backtoback.mojo": ["//:nvidia_gpu"],  # FIXME: KERN-1377
}

_TEST_SIZE = {
    "test_matmul_kernel_10.mojo": "large",
}

_EXTRA_DEPS = {
    "test_matmul_kernel_10.mojo": ["//max:max_mojo"],
    "test_stencil_gpu.mojo": ["//max:max_mojo"],
}

_GPU_MEMORY = {
    "test_matmul_int.mojo": "1",
}

[
    mojo_filecheck_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:nn",
            "//max:quantization",
            "@mojo//:std",
        ],
    )
    for src in _FILECHECK_TESTS
]

[
    mojo_test(
        name = src + ".test",
        size = _TEST_SIZE.get(src, "medium"),
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "2"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:nn",
            "//max:quantization",
            "@mojo//:std",
        ] + _EXTRA_DEPS.get(src, []),
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = _FILECHECK_TESTS,
    )
]
