load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_library")

# AppleGPURT — our implementation of the AsyncRT device ABI, replacing the
# closed AsyncRTMojoBindings/MGPRT that ship only as binaries in the modular
# wheel. CPU backend in AppleGPURT.cpp; Apple Silicon Metal backend in
# AppleGPUMetal.cpp. See AIR_APPLE_SILICON.md.
modular_cc_library(
    name = "MojoBindings",
    srcs = [
        "AppleGPURT.cpp",
        "AppleGPUMetal.cpp",
    ],
    hdrs = ["AppleGPUInternal.h"],
    linkopts = [
        "-framework",
        "Metal",
        "-framework",
        "CoreFoundation",
        # gpu-core-count lives in the AGXAccelerator IOKit registry entry;
        # Metal exposes no core/SM count of its own.
        "-framework",
        "IOKit",
        "-lobjc",
    ],
    visibility = ["//visibility:public"],
    alwayslink = True,
)

# Headerless ABI smoke: drives the runtime exactly as Mojo's external_calls
# will find it — local prototypes only, no shared header. MSL saxpy on the
# first Metal device, verified element by element.
modular_cc_binary(
    name = "applegpu_metal_smoke",
    srcs = ["applegpu_metal_smoke.c"],
    deps = [":MojoBindings"],
)

# The capability table is generated from the runtime source, so it can drift
# the moment someone implements a stub and does not re-run the generator. A
# table nobody trusts is worse than no table -- the whole point is to say what
# an entry point will do BEFORE you call it -- so the check is a test.
sh_test(
    name = "abi_table_up_to_date",
    srcs = ["tools/check-abi-table.sh"],
    data = [
        "ABI-NOTES.md",
        "AppleGPUMetal.cpp",
        "AppleGPURT.cpp",
        "tools/gen-abi-table.py",
    ],
)
