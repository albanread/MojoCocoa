# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
local.bazelrc
/bazel-*
/MODULE.bazel.lock
/external
# Build output at the repo ROOT only (bazelisk lands in ./build, and
# .bazelrc imports build/wrapper.bazelrc). Was a bare `build/`, which git
# matches at any depth -- and under macOS core.ignorecase it also matched
# `Build/`. That cost KGEN/tools/mojo/Build/ (mojo-build.cpp and its
# tablegen, without which //KGEN:mojo does not even analyse) plus the 30
# files under KGEN/test/mojo-tool/build/. Same failure as `target/` below.
/build/
# What Roast writes when you press cmd-B in one of the shipped examples: the
# binary lands in <project>/build/ beside its source. Spelled out per level
# rather than as a bare `build/`, for the reason above.
/examples/*/build/
/examples/fern/fern.png
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Local development only file
/repro.mojo

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

