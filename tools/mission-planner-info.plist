<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded as __TEXT,__info_plist in the bare binary, so the process has a
     bundle identity even when nobody has built the .app: the TCC prompts read
     it, and it is what names the process in Activity Monitor.

     It is NOT enough for `tell application "Mission Planner"` — that asks
     Launch Services, which only knows about bundles. See
     tools/make-planner-app.sh. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>  <string>org.mojococoa.missionplanner</string>
  <key>CFBundleName</key>        <string>Mission Planner</string>
  <key>NSAppleScriptEnabled</key><true/>
</dict>
</plist>
