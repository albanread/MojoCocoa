<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Two entitlements, both weakening the hardened runtime, both needed, and
  justified here so the justification lives in one place.

  allow-jit
      `cocoamojo run` compiles to memory and jumps into it. MACDART's dart
      VM is already signed this way on this machine, so this is a solved
      problem rather than a new risk.

  disable-library-validation
      lldb loads libMojoLLDB.dylib at run time, and a hardened process
      refuses a library it did not ship with. Without this the debugger
      quietly answers nothing, which is precisely how a plugin that failed
      to load presents itself.

  Note for editors of this file: an XML comment may not contain a double
  hyphen. AMFI rejects the whole plist for it, codesign then signs with NO
  entitlements, and the failure surfaces much later as a debugger that
  will not load its plugin.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>                  <true/>
  <key>com.apple.security.cs.disable-library-validation</key> <true/>
</dict>
</plist>
