#!/usr/bin/env bash
# CocoaMojo -- the Mojo compiler for Cocoa on Apple silicon.
#
#   cocoamojo --run   hello.mojo          compile and run
#   cocoamojo --build hello.mojo          -> ./hello  (a normal double-clickable binary)
#   cocoamojo --build hello.mojo -o app   -> ./app
#   cocoamojo --version
#
# No bazel, no environment variables, no -I flags. Everything this needs lives
# beside it in the distribution:
#
#   bin/cocoamojo-compiler          the compiler
#   lib/libKGENCompilerRTShared     Mojo runtime
#   lib/libCocoaMojoGPU             Metal/AsyncRT device runtime (GPU kernels)
#   lib/mojo/{stdlib,max,kernels}   the packages
#   share/cocoa.sqlite              the SDK database the elaborator reads
#
# Binaries produced by --build carry an rpath to lib/, so they run anywhere on
# this machine without a wrapper. Copy the distribution and they keep working;
# move it and rebuild.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPILER="$HERE/bin/cocoamojo-compiler"
LIB="$HERE/lib"
PKG="$LIB/mojo"

[ -x "$COMPILER" ] || { echo "cocoamojo: no compiler at $COMPILER" >&2; exit 1; }

export MODULAR_MOJO_MAX_COCOAKB_PATH="${MODULAR_MOJO_MAX_COCOAKB_PATH:-$HERE/share/cocoa.sqlite}"
export MODULAR_MOJO_MAX_COMPILERRT_PATH="${MODULAR_MOJO_MAX_COMPILERRT_PATH:-$LIB/libKGENCompilerRTShared.dylib}"
# No crashpad handler ships here, and its absence is not news to anyone.
export MODULAR_CRASH_REPORTING_ENABLED="${MODULAR_CRASH_REPORTING_ENABLED:-false}"
export DYLD_LIBRARY_PATH="$LIB:${DYLD_LIBRARY_PATH:-}"
# A program launched from here can find the toolchain it was built by --
# the playground uses this to run your buffer with this same compiler.
export COCOAMOJO_ROOT="$HERE"

# The standard library may live in user space (an installed Roast copies it
# to Application Support so people can edit it); COCOAMOJO_STDLIB points
# there. max and kernels stay the toolchain's own.
STD="${COCOAMOJO_STDLIB:-$PKG/stdlib}"
INC=(-I "$STD" -I "$PKG/max" -I "$PKG/kernels")

# Cocoa is not a library you opt into here -- it is the platform. Every build
# gets libobjc and the frameworks, and the GPU runtime that makes DeviceContext
# resolve. A program that uses none of them pays nothing but a load command.
LINK=(
  -Xlinker -lobjc
  -Xlinker -L"$LIB" -Xlinker -lCocoaMojoGPU
  -Xlinker -rpath -Xlinker "$LIB"
  -Xlinker -framework -Xlinker Foundation
  -Xlinker -framework -Xlinker AppKit
  -Xlinker -framework -Xlinker Metal
  -Xlinker -framework -Xlinker QuartzCore
  # AudioToolbox, for the same reason as the rest: a program that wants sound
  # should not have to discover a link flag, and one that does not pays a load
  # command. The render callback in examples/sid is a plain Mojo `fn` handed
  # straight to AudioUnitSetProperty, so nothing else is needed to make audio
  # work -- only this.
  -Xlinker -framework -Xlinker AudioToolbox
  # libz ships with macOS at /usr/lib/libz.dylib. It is here rather than left
  # to each program because a graphical one usually wants to write a PNG
  # eventually, and a project has no way to ask for a link flag -- the same
  # gap as sharing an include path, and the same answer when a project file
  # arrives.
  -Xlinker -lz
)

usage() { sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

cmd="${1:-}"; shift || true
case "$cmd" in
  --build|build)
    src="${1:?cocoamojo: --build needs a .mojo file}"; shift
    # Default the output name from the source, the way a person expects.
    case " $* " in *" -o "*) out=("") && unset out ;; *) out=(-o "./$(basename "${src%.mojo}")") ;; esac
    exec "$COMPILER" build "${INC[@]}" --target-accelerator apple-m4 \
         "${LINK[@]}" ${out+"${out[@]}"} "$src" "$@"
    ;;
  --run|run)
    src="${1:?cocoamojo: --run needs a .mojo file}"; shift
    # JIT it. This used to build to a temporary binary and exec that, because
    # the JIT could not resolve the GPU runtime's symbols:
    #
    #   JIT session error: Symbols not found: [_AsyncRT_DeviceContext_create...]
    #
    # That was never a limitation of the JIT. ExecutionEngineOptions::libraryPaths
    # feeds an ORC dynamic-library search generator, and -Xlinker -L/-l reach it;
    # the symbols were missing because nothing exported them until
    # libCocoaMojoGPU.dylib existed. Handed that dylib, the JIT runs GPU kernels
    # and opens windows -- frameworks are dlopen'd at run time, so their absence
    # from the JIT's link line does not matter.
    #
    # Only -L, -l, -rpath and absolute dylib paths reach the JIT; anything else
    # is dropped with a warning, which is why the framework flags in LINK are
    # not passed here.
    exec "$COMPILER" run "${INC[@]}" --target-accelerator apple-m4 \
        -Xlinker -L"$LIB" -Xlinker -lCocoaMojoGPU "$src" "$@"
    ;;
  --version|version)
    echo "CocoaMojo -- Mojo for Cocoa, Apple silicon"
    "$COMPILER" --version 2>/dev/null | head -2
    ;;
  --help|-h|help|"") usage ;;
  *) exec "$COMPILER" "$cmd" "${INC[@]}" "$@" ;;
esac
